# DevNull Daemon Configuration
# Copy to .env and adjust values

# Server
DEVNULL_HOST=127.0.0.1
DEVNULL_PORT=9876

# Security: shared token for app<->daemon auth
DEVNULL_AUTH_TOKEN=change-me-to-a-secure-random-string

# Detection mode: "polling" or "udev"
DEVNULL_DETECTION_MODE=udev

# Polling interval in seconds (only for polling mode)
DEVNULL_POLL_INTERVAL=5

# Mount base path
DEVNULL_MOUNT_BASE=/media/devnull

# Mount strategy: "udisks" or "sudo"
DEVNULL_MOUNT_STRATEGY=udisks

# Nextcloud integration
DEVNULL_NEXTCLOUD_URL=http://127.0.0.1
DEVNULL_NEXTCLOUD_VERIFY_SSL=false
DEVNULL_AUTO_MOUNT_ON_PLUG=false

# Logging
DEVNULL_LOG_LEVEL=INFO
